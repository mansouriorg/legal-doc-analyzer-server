# Copy this file to .env and fill in the values: cp .env.example .env
# The .env file stays on your computer, because git ignores it.
# A value given in the shell wins over this file, for example: PORT=3002 pnpm start:dev

# The port to listen on. Default: 3001. The client calls port 3001.
# PORT=3001

# The address of the client page. Default: http://localhost:3000
# Several addresses can be given, separated by commas.
# CLIENT_ORIGIN=http://localhost:3000

# The address to listen on. Default: 127.0.0.1, which only this computer can reach.
# The client page runs in your browser on the same computer, so it still works.
# Use 0.0.0.0 to let other computers reach the server (for example in a container).
# The server has no login, so only do that on a network you trust.
# LISTEN_HOST=127.0.0.1

# The AI service that analyzes the documents and answers the questions about
# the saved analyses (POST /documents/:id/ask).
# It can be any service with an OpenAI-compatible chat API. See the README.
# Example with Ollama on this computer (use 127.0.0.1, not localhost):
#   AI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_MODEL=qwen2.5:7b
#   AI_API_KEY=
# The address of the service, up to and including /v1 (or the path the service documents):
AI_BASE_URL=
# The model name, as written on the website of the service:
AI_MODEL=
# The key of your account on that service. Leave it empty for a service on your own computer:
AI_API_KEY=

# Optional limits. Remove the # to change one. A value that is not a whole number in the range is ignored.
# How long to wait for the answer of the service, in seconds (5 to 600). Default: 120
# AI_TIMEOUT_SECONDS=120
# The longest text sent to the model, in characters (1000 to 500000). Default: 30000
# It also limits the part of a saved analysis that is sent with a question.
# AI_MAX_INPUT_CHARS=30000

# The folder for the saved analyses, one .json file for each analysis. The files hold
# quotes from your documents, so keep the folder private. Git ignores the default folder.
# POST /analyze saves every analysis that works there (unless SAVE_ANALYSES says no, see below),
# and DELETE /documents/:id deletes one.
# A relative path starts from the folder where the server is started. Default: data
# DATA_DIR=data

# Whether POST /analyze saves the analyses. The saved files hold quotes from your documents.
# false (also no, off or 0) saves nothing: the person still gets the analysis, but it is not in
# the list of saved analyses and no question can be asked about it later. The analyses that are
# already in the folder stay, and can still be read and deleted. One upload can also ask for no
# saving with the form field save=false. A value that is not true or false turns saving off, and
# the log says so. Default: true
# SAVE_ANALYSES=true
